{
  "name": "TachTach Admin",
  "short_name": "TachTach",
  "description": "Control the TachTach screen — announcements, schedule, and slides.",
  "start_url": "/admin/",
  "scope": "/admin/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#12100C",
  "theme_color": "#12100C",
  "shortcuts": [
    { "name": "Post a message", "short_name": "Post", "url": "/admin/?action=post", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Change tomorrow", "short_name": "Tomorrow", "url": "/admin/?action=tomorrow", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
