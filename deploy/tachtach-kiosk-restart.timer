# Restarts the Chromium kiosk periodically (see OnCalendar below; it used to be
# once a night, before Track B's 4:00 AM data refresh). Chromium's GPU compositor has been observed to degrade after many
# hours of continuous native-4K rendering (grain overlay, gradients, box
# shadows, the whole-canvas scale transform) — symptoms range from washed-out
# unstyled rendering to a frozen display. A nightly restart is cheap, safe
# (the kiosk has no state of its own — it's a browser window pointed at
# /screen), and keeps GPU state from ever accumulating enough degradation to
# fail during the day.
[Unit]
Description=Periodic TachTach-Screens Kiosk Restart Timer

[Timer]
# Every 4 hours (not just nightly): on 2026-10-15 the GPU failed 5h12m after the
# 03:15 restart (journal: AllocateRingBuffer / kFatalFailure flood, TV showing
# stale/garbled tiles). Memory, /tmp, thermals and dmesg were all clean, so this
# looks like GPU buffers degrading with uptime; restarting well inside that
# window keeps it from happening on screen. The launcher's GPU watchdog is the
# backup if it fails sooner. Each restart is a few seconds of blank screen.
OnCalendar=*-*-* 03,07,11,15,19,23:15:00
# Persistent=false on purpose. The Pi boots with a stale clock (no RTC
# battery) and NTP then jumps it forward days/weeks; with Persistent=true that
# jump counted as "missed 3:15 runs" and fired restarts right at boot, which
# tripped the kiosk's old start limit and left the TV blank. A missed nightly
# restart doesn't need catching up — the kiosk was just (re)started anyway.
Persistent=false

[Install]
WantedBy=timers.target
